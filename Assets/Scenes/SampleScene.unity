  m_text: "\u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B \u2013 \u043A\u0430\u043A
    \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
    \u0434\u043E \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B
    \u0438 \u0438\u0437\u0431\u0435\u0433\u0430\u044F \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439
    \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043A\u043E\u0441\u043C\u043E\u0441\u0435.\n"
